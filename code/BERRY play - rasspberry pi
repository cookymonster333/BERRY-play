#!/usr/bin/env python3
"""
BERRY play Player (Full Screen Version for Raspberry Pi)
========================================================
A single-window, full-screen media player optimized for Raspberry Pi 3 A+.
"""

import os
import sys
import string
import random
import socket
import subprocess
import time
import threading
import ctypes
import shutil
import tkinter as tk
from tkinter import messagebox

DRIVE_NAME = "BERRY play"
SEARCH_DIRS = ["/media", "/mnt"]   # Linux/Pi: where drives auto-mount
POLL_SECONDS = 2                   # how often to check if drive is plugged in
PLAYABLE_EXTENSIONS = (".mp3", ".mp4")

IS_WINDOWS = os.name == "nt"

WINDOWS_VLC_PATHS = [
    r"C:\Program Files\VideoLAN\VLC\vlc.exe",
    r"C:\Program Files (x86)\VideoLAN\VLC\vlc.exe",
]

# ---------------------------------------------------------------------------
# Minimal dark colour palette
# ---------------------------------------------------------------------------
BG = "#1c1c1c"          # main background
BG_PANEL = "#242424"    # slightly lighter panels (listbox, control bar)
FG = "#e4e4e4"          # normal text
FG_MUTED = "#8a8a8a"    # secondary / status text
ACCENT = "#4caf82"      # active/toggle highlight
ACCENT_BG = "#20362c"   # active toggle button background
DANGER = "#c0524a"      # quit button
BORDER_COLOR = "#ffffff"

# Adjusted larger fonts for Raspberry Pi displays
FONT = ("DejaVu Sans", 12)
FONT_SMALL = ("DejaVu Sans", 10)
FONT_LARGE = ("DejaVu Sans", 14, "bold")


def flat_button(parent, **kwargs):
    """A tk.Button pre-styled to look flat and touch-friendly."""
    defaults = dict(
        bg=BG_PANEL, fg=FG, activebackground=BG_PANEL, activeforeground=ACCENT,
        relief="flat", bd=0, highlightthickness=0, font=FONT, padx=12, pady=8,
        cursor="hand2",
    )
    defaults.update(kwargs)
    return tk.Button(parent, **defaults)


def find_drive_path():
    if IS_WINDOWS:
        return _find_drive_windows()
    return _find_drive_linux()


def _find_drive_windows():
    kernel32 = ctypes.windll.kernel32
    bitmask = kernel32.GetLogicalDrives()
    for i, letter in enumerate(string.ascii_uppercase):
        if bitmask & (1 << i):
            drive = f"{letter}:\\"
            name_buf = ctypes.create_unicode_buffer(1024)
            kernel32.GetVolumeInformationW(
                ctypes.c_wchar_p(drive), name_buf, ctypes.sizeof(name_buf),
                None, None, None, None, 0
            )
            if name_buf.value.upper() == DRIVE_NAME.upper():
                return drive
    return None


def _find_drive_linux():
    for base in SEARCH_DIRS:
        if not os.path.isdir(base):
            continue
        candidates = [base] + [
            os.path.join(base, d) for d in os.listdir(base)
            if os.path.isdir(os.path.join(base, d))
        ]
        for folder in candidates:
            try:
                for entry in os.listdir(folder):
                    full = os.path.join(folder, entry)
                    if os.path.isdir(full) and entry.upper() == DRIVE_NAME.upper():
                        return full
            except PermissionError:
                continue
    return None


def find_vlc():
    if IS_WINDOWS:
        for path in WINDOWS_VLC_PATHS:
            if os.path.isfile(path):
                return path
        vlc_in_path = shutil.which("vlc.exe") or shutil.which("vlc")
        if vlc_in_path:
            return vlc_in_path
        return None
    else:
        return shutil.which("cvlc") or shutil.which("vlc") or "vlc"


def get_free_port():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


SW_HIDE = 0
SW_MINIMIZE = 6
SW_RESTORE = 9
CONSOLE_HWND = None


def _find_windows_for_pid(pid):
    hwnds = []
    user32 = ctypes.windll.user32
    EnumWindowsProc = ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_int, ctypes.c_int)

    def enum_handler(hwnd, lparam):
        wnd_pid = ctypes.c_ulong()
        user32.GetWindowThreadProcessId(hwnd, ctypes.byref(wnd_pid))
        if wnd_pid.value == pid and user32.IsWindowVisible(hwnd):
            hwnds.append(hwnd)
        return True

    user32.EnumWindows(EnumWindowsProc(enum_handler), 0)
    return hwnds


def set_process_window_state(pid, minimize=True):
    if not IS_WINDOWS or not pid:
        return
    user32 = ctypes.windll.user32
    for hwnd in _find_windows_for_pid(pid):
        user32.ShowWindow(hwnd, SW_MINIMIZE if minimize else SW_RESTORE)


def wait_and_minimize_process_window(pid, find_attempts=20, find_delay=0.15,
                                      reinforce_attempts=6, reinforce_delay=0.15):
    if not IS_WINDOWS or not pid:
        return
    found = False
    for _ in range(find_attempts):
        if _find_windows_for_pid(pid):
            found = True
            break
        time.sleep(find_delay)
    if not found:
        return
    for _ in range(reinforce_attempts):
        set_process_window_state(pid, minimize=True)
        time.sleep(reinforce_delay)


def hide_console_window():
    if not IS_WINDOWS:
        return
    global CONSOLE_HWND
    hwnd = ctypes.windll.kernel32.GetConsoleWindow()
    if hwnd:
        CONSOLE_HWND = hwnd
        ctypes.windll.user32.ShowWindow(hwnd, SW_HIDE)


